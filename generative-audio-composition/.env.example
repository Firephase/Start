# Generative Audio Composition - Environment Configuration
# Copy to .env and fill in values

# ── Storage paths ──────────────────────────────────────────────────────────────
GAC_UPLOAD_DIR=/data/uploads
GAC_OUTPUT_DIR=/data/outputs
GAC_MODELS_DIR=/models

# ── Model checkpoints ──────────────────────────────────────────────────────────
GAC_DIFFSINGER_PATH=/models/diffsinger/checkpoint_best.pt
GAC_SPEAKER_ENCODER_PATH=/models/speaker_encoder/checkpoint_best.pt
GAC_MUSICGEN_PATH=/models/musicgen_lora          # or facebook/musicgen-large
GAC_LYRICS_MODEL_PATH=/models/lyrics_llm          # or meta-llama/Meta-Llama-3.1-8B-Instruct
GAC_WHISPER_SIZE=large-v3

# ── Hardware ───────────────────────────────────────────────────────────────────
GAC_DEVICE=cuda

# ── Redis / Celery ─────────────────────────────────────────────────────────────
GAC_REDIS_URL=redis://redis:6379/0

# ── Limits ─────────────────────────────────────────────────────────────────────
GAC_MAX_AUDIO_FILES=10
GAC_MAX_AUDIO_DURATION_PER_FILE=180.0
GAC_MAX_OUTPUT_DURATION=480.0
GAC_MIN_OUTPUT_DURATION=30.0

# ── W&B (training) ────────────────────────────────────────────────────────────
WANDB_API_KEY=your_key_here
WANDB_PROJECT=generative-audio-composition

# ── HuggingFace (model downloads) ─────────────────────────────────────────────
HUGGING_FACE_HUB_TOKEN=your_token_here
